{
	"name": "sapphire-rwa-library",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"npm run serve:dist\" \"npm run build:watch\"",
		"serve:dist": "vite preview --port 4173 --strictPort",
		"build:watch": "vite build --watch --mode dev",
		"build": "tsc && vite build --mode prod",
		"build:icons": "node build-icon-sprite.mjs"
	},
	"dependencies": {
		"concurrently": "^9.2.1",
		"dompurify": "^3.4.10",
		"prettier": "^3.8.3",
		"quill": "^2.0.3",
		"sass": "^1.99.0",
		"stylelint": "^17.11.0",
		"stylelint-order": "^8.1.1",
		"typescript": "~6.0.3",
		"vite": "^8.0.11",
		"vite-plugin-mkcert": "^2.0.0"
	},
	"devDependencies": {
		"esbuild": "^0.28.0",
		"source-map-js": "^1.2.1"
	}
}
